// Przykład błędny (Negatywny test kolizyjny):
// Kolizja tramwaju z lewoskrętem samochodowym.
// W kroku 2 tramwaj ma zezwolenie na jazdę (TRAM_JAZDA), a samochody przecinające torowisko
// otrzymują jednocześnie ZIELONE światło. Kompilator musi natychmiast odrzucić program!

skrzyzowanie "Niebezpieczna_Kolizja_Tramwaj_Auto" {
    kierunki {
        Lewoskret_Auta: pojazdy;
        Tramwaj_Tor_1: tramwaje;
        Piesi_Przejscie: piesi;
    }

    kolizje {
        // Tory tramwaju przecinają pas lewoskrętu samochodowego
        Tramwaj_Tor_1 <-> Lewoskret_Auta;
        Lewoskret_Auta <-> Piesi_Przejscie;
    }

    cykl {
        // Krok 1: Faza bezpieczna
        krok(czas: 15s) {
            Lewoskret_Auta: CZERWONE;
            Tramwaj_Tor_1: TRAM_JAZDA;
            Piesi_Przejscie: CZERWONE;
        }

        // Krok 2: KATASTROFALNY BŁĄD — jednoczesna jazda tramwaju i aut przecinających tor!
        krok(czas: 10s) {
            Lewoskret_Auta: ZIELONE;
            Tramwaj_Tor_1: TRAM_JAZDA;
            Piesi_Przejscie: CZERWONE;
        }
    }
}
