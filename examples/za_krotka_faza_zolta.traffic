// Przykład błędny (Negatywny test norm czasowych bezpieczeństwa):
// Faza żółta trwająca tylko 1s (zamiast polskiego minimum bezpieczeństwa 2s/3s).
// Kierowca nie ma fizycznej możliwości zatrzymania pojazdu z prędkości 50 km/h.
// Kompilator musi przerwać kompilację z błędem InvalidTimeDurationError!

skrzyzowanie "Za_Krotkie_Zolte" {
    kierunki {
        Wlot_A: pojazdy;
        Wlot_B: pojazdy;
    }

    kolizje {
        Wlot_A <-> Wlot_B;
    }

    cykl {
        krok(czas: 20s) {
            Wlot_A: ZIELONE;
            Wlot_B: CZERWONE;
        }

        // BŁĄD CZASOWY: 1s żółtego to za mało na bezpieczne wyhamowanie!
        krok(czas: 1s) {
            Wlot_A: ZOLTE;
            Wlot_B: CZERWONE;
        }

        krok(czas: 2s) {
            Wlot_A: CZERWONE;
            Wlot_B: CZERWONE_ZOLTE;
        }

        krok(czas: 20s) {
            Wlot_A: CZERWONE;
            Wlot_B: ZIELONE;
        }

        krok(czas: 3s) {
            Wlot_A: CZERWONE;
            Wlot_B: ZOLTE;
        }

        krok(czas: 2s) {
            Wlot_A: CZERWONE_ZOLTE;
            Wlot_B: CZERWONE;
        }
    }
}
