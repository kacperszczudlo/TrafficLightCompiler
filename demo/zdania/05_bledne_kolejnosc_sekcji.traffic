// ZDANIE NIEPOPRAWNE: sekcja "kolizje" stoi po "cykl".
// Gramatyka wymaga kolejności: kierunki, [kolizje], cykl.
skrzyzowanie "Przejscie" {
    kierunki {
        Ulica: pojazdy;
        Przejscie: piesi;
    }
    cykl {
        krok(czas: 20s) { Ulica: ZIELONE;  Przejscie: CZERWONE; }
        krok(czas: 15s) { Ulica: CZERWONE; Przejscie: ZIELONE;  }
    }
    kolizje {
        Ulica <-> Przejscie;
    }
}
